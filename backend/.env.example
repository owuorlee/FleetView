# Copy to .env and fill in. Never commit .env.
PORT=3000

# PostgreSQL "app" database (see infra/docker-compose.yml for local dev)
DATABASE_URL=postgresql://app:devpassword@localhost:5432/app

# JWT (dev: HS256 shared secret; production: move to RS256 keypair per spec §10)
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Traccar (leave TRACCAR_URL empty to run backend without a tracking engine)
TRACCAR_URL=http://localhost:8082
TRACCAR_TOKEN=

# SMS: "dev" logs OTPs/messages to console; "africastalking" sends real SMS
SMS_PROVIDER=dev
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# M-Pesa Daraja (leave keys empty to run without billing; sandbox base by default)
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# Sandbox test shortcode is 174379; its public Lipa na M-Pesa passkey is on the
# Daraja "Test Credentials" page. Production values come with the PayBill go-live.
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Public HTTPS base for callbacks (e.g. https://api.fleetview.co.ke or an ngrok URL in dev)
DARAJA_CALLBACK_BASE_URL=
# Unguessable path segment for callback URLs: openssl rand -hex 16
DARAJA_WEBHOOK_SECRET=
